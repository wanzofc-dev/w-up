    }
    @media (max-width: 1180px) {
        .docs-shell {
            grid-template-columns: 1fr;
        }
        .docs-sidebar {
            position: fixed;
            top: 88px;
            left: 1rem;
            right: 1rem;
            z-index: 110;
            display: none;
            max-height: calc(100vh - 120px);
            overflow-y: auto;
        }
        .docs-sidebar.active {
