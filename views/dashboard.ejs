<%- include('partials/header', { title: 'Dashboard', pageCss: 'dashboard' }) %>

<div class="dashboard-layout">
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="sidebar" id="mainSidebar">
        <div class="sidebar-header-mobile">
            <h3>Menu</h3>
            <button class="icon-btn" id="closeSidebarBtn"><i class="fa-solid fa-times"></i></button>
        </div>

        <div class="sidebar-menu">
            <a href="/dashboard" class="menu-item <%= !query.filter && !query.type && !query.folderId ? 'active' : '' %>">
                <i class="fa-solid fa-hard-drive"></i> My Files
            </a>
            <a href="/dashboard?filter=shared" class="menu-item <%= query.filter === 'shared' ? 'active' : '' %>">
                <i class="fa-solid fa-users"></i> Shared with me
            </a>
            <a href="/dashboard?filter=starred" class="menu-item <%= query.filter === 'starred' ? 'active' : '' %>">
                <i class="fa-solid fa-star"></i> Starred
            </a>
            <a href="/dashboard/teams" class="menu-item <%= locals.currentUrl && currentUrl.includes('/dashboard/teams') ? 'active' : '' %>">
                <i class="fa-solid fa-people-group"></i> Teams
            </a>
            <a href="/dashboard?filter=trash" class="menu-item <%= query.filter === 'trash' ? 'active' : '' %>">
                <i class="fa-solid fa-trash-can"></i> Trash
            </a>
            
            <div class="separator"></div>
            <p class="menu-header">Types</p>
            <a href="/dashboard?type=image" class="menu-item <%= query.type === 'image' ? 'active' : '' %>">
                <i class="fa-solid fa-image"></i> Images
            </a>
            <a href="/dashboard?type=video" class="menu-item <%= query.type === 'video' ? 'active' : '' %>">
                <i class="fa-solid fa-video"></i> Videos
            </a>
            <a href="/dashboard?type=doc" class="menu-item <%= query.type === 'doc' ? 'active' : '' %>">
                <i class="fa-solid fa-file-lines"></i> Documents
            </a>
        </div>
        
        <div class="storage-info">
            <% 
                const totalLimit = user.storageLimit + (user.storageBonus || 0);
                const used = user.storageUsed || 0;
                const percentage = totalLimit > 0 ? Math.min(100, (used / totalLimit) * 100) : 0;
            %>
            <div class="storage-label-row">
                <span>Storage</span>
                <strong id="storagePercent"><%= percentage.toFixed(1) %>%</strong>
            </div>
            <div class="progress-bar"><div class="fill" id="storageFill" style="width: <%= percentage %>%;"></div></div>
            <small id="storageMeta" data-storage-used="<%= used %>" data-storage-total="<%= totalLimit %>">
                <%= (used / 1024 / 1024 / 1024).toFixed(2) %> GB / <%= (totalLimit / 1024 / 1024 / 1024).toFixed(2) %> GB
            </small>
        </div>
    </aside>

    <main class="main-content" id="dropZone">
        <section class="action-bar">
            <div class="left-actions">
                <button class="icon-btn mobile-menu-btn" id="sidebarToggle">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <button class="primary-btn" id="uploadBtn">
                    <i class="fa-solid fa-cloud-arrow-up"></i> <span>Upload</span>
                </button>
                <div class="dropdown">
                    <button class="secondary-btn">
                        <i class="fa-solid fa-plus"></i> <span>New</span>
                    </button>
                    <div class="dropdown-content">
                        <a href="#" id="newFolderBtn"><i class="fa-solid fa-folder-plus"></i> Folder</a>
                        <a href="#" id="remoteUploadBtn"><i class="fa-solid fa-link"></i> Remote URL</a>
                        <a href="#" id="fileRequestBtn"><i class="fa-solid fa-file-import"></i> File Request</a>
                    </div>
                </div>
            </div>
            
            <div class="search-bar-wrapper">
                <form method="GET" action="/dashboard">
                    <% if (query.folderId) { %><input type="hidden" name="folderId" value="<%= query.folderId %>"><% } %>
                    <i class="fa-solid fa-search"></i>
                    <input type="text" name="q" placeholder="Search files..." value="<%= query.q || '' %>">
                </form>
            </div>

            <div class="right-actions">
                <% if (query.filter === 'trash') { %>
                    <button class="danger-btn" id="emptyTrashBtn">Empty Trash</button>
                <% } else { %>
                    <a href="/dashboard?sortBy=createdAt&sortOrder=<%= query.sortOrder === 'asc' ? 'desc' : 'asc' %>" class="icon-btn" title="Sort by Date">
                        <i class="fa-solid fa-arrow-down-wide-short"></i>
                    </a>
                <% } %>
            </div>
        </section>

        <section class="dashboard-hero">
            <div class="dashboard-hero-copy">
                <span class="dashboard-hero-badge">Server-Synced Workspace</span>
                <h2><%= currentFolder ? currentFolder.originalName : 'Dashboard utama Anda' %> sekarang tersambung langsung ke file server, statistik storage, dan upload queue real-time.</h2>
                <p>Owned files, folder, shared items, dan pemakaian storage di bawah ini selalu mengikuti data server aktif. Upload baru juga masuk ke queue modal tanpa me-refresh halaman.</p>
                <div class="hero-storage-strip">
                    <div>
                        <small>Storage capacity</small>
                        <strong id="heroStorageUsage"><%= (used / 1024 / 1024 / 1024).toFixed(2) %> GB / <%= (totalLimit / 1024 / 1024 / 1024).toFixed(2) %> GB</strong>
                    </div>
                    <div class="hero-storage-rail">
                        <div class="hero-storage-fill" id="heroStorageFill" style="width: <%= percentage %>%;"></div>
                    </div>
                </div>
            </div>
            <div class="dashboard-hero-stats">
                <article class="hero-stat-card">
                    <small>Owned files</small>
                    <strong id="statOwnedFiles" data-value="<%= dashboardStats ? dashboardStats.ownedFiles : files.length %>"><%= dashboardStats ? dashboardStats.ownedFiles : files.length %></strong>
                    <span>File aktif milik akun ini.</span>
                </article>
                <article class="hero-stat-card">
                    <small>Folders</small>
                    <strong id="statOwnedFolders" data-value="<%= dashboardStats ? dashboardStats.ownedFolders : 0 %>"><%= dashboardStats ? dashboardStats.ownedFolders : 0 %></strong>
                    <span>Ruang kerja yang sudah disusun.</span>
                </article>
                <article class="hero-stat-card">
                    <small>Shared items</small>
                    <strong id="statSharedItems" data-value="<%= dashboardStats ? dashboardStats.sharedItems : 0 %>"><%= dashboardStats ? dashboardStats.sharedItems : 0 %></strong>
                    <span>Item yang melibatkan kolaborator.</span>
                </article>
                <article class="hero-stat-card">
                    <small>Storage used</small>
                    <strong id="statStorageUsed" data-bytes="<%= dashboardStats ? dashboardStats.currentUsage : 0 %>"><%= dashboardStats ? (dashboardStats.currentUsage / 1024 / 1024 / 1024).toFixed(2) : '0.00' %> GB</strong>
                    <span id="statStorageDetail"><%= (used / 1024 / 1024 / 1024).toFixed(2) %> / <%= (totalLimit / 1024 / 1024 / 1024).toFixed(2) %> GB tersinkron.</span>
                </article>
                <article class="hero-stat-card">
                    <small>Total downloads</small>
                    <strong id="statDownloads" data-value="<%= dashboardStats ? dashboardStats.totalDownloads : 0 %>"><%= dashboardStats ? dashboardStats.totalDownloads : 0 %></strong>
                    <span>Total download dari file pada view ini.</span>
                </article>
            </div>
        </section>

        <section class="dashboard-quick-grid">
            <button class="quick-card" type="button" id="quickUploadBtn">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <div>
                    <strong>Upload cepat</strong>
                    <small>Tarik file atau pilih dari perangkat.</small>
                </div>
            </button>
            <button class="quick-card" type="button" id="quickFolderBtn">
                <i class="fa-solid fa-folder-plus"></i>
                <div>
                    <strong>Buat folder</strong>
                    <small>Rapikan struktur kerja Anda lebih cepat.</small>
                </div>
            </button>
            <button class="quick-card" type="button" id="quickRequestBtn">
                <i class="fa-solid fa-file-import"></i>
                <div>
                    <strong>File request</strong>
                    <small>Buat link untuk menerima file dari orang lain.</small>
                </div>
            </button>
        </section>

        <% if (breadcrumbs && breadcrumbs.length > 0) { %>
            <div class="breadcrumbs">
                <a href="/dashboard"><i class="fa-solid fa-home"></i></a>
                <% breadcrumbs.forEach(bc => { %>
                    <span>/</span>
                    <a href="/dashboard?folderId=<%= bc.id %>"><%= bc.name %></a>
                <% }) %>
            </div>
        <% } %>

        <section class="file-grid" id="fileGrid">
            <% if (files.length === 0) { %>
                <div class="empty-state">
                    <i class="fa-solid fa-folder-open"></i>
                    <p>No files found.</p>
                </div>
            <% } %>

            <% files.forEach(file => { 
                const ext = file.originalName.split('.').pop().toLowerCase();
            %>
                <div class="file-card <%= file.isFolder ? 'folder' : '' %>" 
                     data-id="<%= file._id %>" 
                     data-name="<%= file.originalName %>"
                     data-alias="<%= file.customAlias %>"
                     data-type="<%= file.isFolder ? 'folder' : 'file' %>"
                     data-content-type="<%= file.contentType %>"
                     data-is-hidden="<%= file.isHidden ? 'true' : 'false' %>"
                     data-size="<%= file.size || 0 %>"
                     data-created-at="<%= file.createdAt ? file.createdAt.toISOString() : '' %>"
                     data-ext="<%= ext %>"
                     draggable="true">
                    
                    <div class="selection-check">
                        <input type="checkbox" class="file-check" value="<%= file._id %>">
                    </div>

                    <div class="file-preview">
                        <% if (file.isFolder) { %><i class="fa-solid fa-folder folder-icon"></i>
                        <% } else if (file.contentType.startsWith('image/')) { %><img src="/w-upload/raw/<%= encodeURIComponent(file.customAlias) %>" alt="<%= file.originalName %>" loading="lazy" class="file-thumb">
                        <% } else if (file.contentType.startsWith('video/')) { %><i class="fa-solid fa-video video-icon"></i>
                        <% } else if (ext === 'pdf') { %><i class="fa-solid fa-file-pdf file-icon"></i>
                        <% } else if (ext === 'zip' || ext === 'rar') { %><i class="fa-solid fa-file-zipper file-icon"></i>
                        <% } else if (ext === 'md') { %><i class="fa-brands fa-markdown file-icon"></i>
                        <% } else if (['js', 'html', 'css', 'py', 'java', 'json', 'xml', 'sql'].includes(ext)) { %><i class="fa-solid fa-file-code file-icon"></i>
                        <% } else { %><i class="fa-solid fa-file file-icon"></i><% } %>
                    </div>
                    
                    <div class="file-details">
                        <a href="<%= file.isFolder ? `/dashboard?folderId=${file._id}` : `/w-upload/file/${file.customAlias}` %>" class="filename">
                            <%= file.originalName %>
                        </a>
                        <div class="meta">
                            <% if (!file.isFolder) { %>
                                <%= (file.size / 1024 / 1024).toFixed(2) %> MB
                                <span class="file-visibility-badge <%= file.isHidden ? 'private' : 'public' %>">
                                    <%= file.isHidden ? 'Private' : 'Public' %>
                                </span>
                            <% } else { %>
                                <% if(file.collaborators && file.collaborators.length > 0) { %>
                                    <i class="fa-solid fa-users" title="Shared Folder"></i>
                                <% } else { %>Folder<% } %>
                            <% } %>
                            <% if (file.isStarred) { %><i class="fa-solid fa-star star-indicator"></i><% } %>
                        </div>
                    </div>

                    <div class="context-trigger"><i class="fa-solid fa-ellipsis-vertical"></i></div>
                </div>
            <% }) %>
        </section>

        <div class="bulk-actions" id="bulkActions">
            <span><span id="selectedCount">0</span> Selected</span>
            <div class="actions">
                <button id="bulkStarBtn" title="Star/Unstar"><i class="fa-solid fa-star"></i></button>
                <button id="bulkMoveBtn" title="Move"><i class="fa-solid fa-folder-open"></i></button>
                <button id="bulkDeleteBtn" class="danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
            </div>
        </div>
    </main>
</div>

<div class="context-menu" id="contextMenu">
    <ul>
        <li id="cmOpen"><i class="fa-solid fa-up-right-from-square"></i> Open / Edit</li>
        <li id="cmShare"><i class="fa-solid fa-share-nodes"></i> Share</li>
        <li id="cmCopyLink"><i class="fa-solid fa-link"></i> Copy Link</li>
        <li id="cmVisibility"><i class="fa-solid fa-eye-slash"></i> Set Private</li>
        <li class="separator" id="cmToolsSeparator"></li>
        <li id="cmOCR"><i class="fa-solid fa-wand-magic-sparkles"></i> Extract Text (OCR)</li>
        <li id="cmConvert"><i class="fa-solid fa-right-left"></i> Convert</li>
        <li id="cmExtract"><i class="fa-solid fa-box-open"></i> Extract Archive</li>
        <li class="separator"></li>
        <li id="cmRename"><i class="fa-solid fa-pen"></i> Rename</li>
        <li id="cmMove"><i class="fa-solid fa-folder-tree"></i> Move</li>
        <li id="cmStar"><i class="fa-solid fa-star"></i> Star/Unstar</li>
        <li id="cmInfo"><i class="fa-solid fa-circle-info"></i> Details</li>
        <li class="separator"></li>
        <li id="cmTransferOwner"><i class="fa-solid fa-user-pen"></i> Transfer Ownership</li>
        <li id="cmDelete" class="danger"><i class="fa-solid fa-trash"></i> Delete</li>
    </ul>
</div>

<div class="modal" id="shareModal"><div class="modal-box" style="max-width:640px"><h3>Share Settings</h3><div class="tabs"><button class="tab-btn active" data-tab="tab-collab">Collaborators</button><button class="tab-btn" data-tab="tab-links">Share Links</button><button class="tab-btn" data-tab="tab-analytics">Analytics</button></div><div class="tab-content active" id="tab-collab"><div style="display:flex;gap:10px;margin-bottom:1rem;"><input type="text" id="shareCollabUser" class="full-input" placeholder="Username"><select id="collabRole" class="full-input" style="width:120px; flex-shrink: 0;"><option value="viewer">Viewer</option><option value="uploader">Uploader</option><option value="editor">Editor</option></select><button class="btn primary-btn" id="addCollabBtn">Add</button></div><div id="collaboratorsList" class="items-list"></div></div><div class="tab-content" id="tab-links"><div class="share-link-toolbar"><span id="visibilityStatusChip" class="file-visibility-badge public">Public</span><button class="btn secondary-btn" id="toggleVisibilityBtn"><i class="fa-solid fa-eye-slash"></i> Set Private</button></div><div class="share-custom-row"><input type="text" id="customPrivateSlug" class="full-input" placeholder="custom-private-link"><button class="btn secondary-btn" id="createShareLinkBtn"><i class="fa-solid fa-plus"></i> Create Link</button></div><div id="shareLinksList" class="items-list"></div></div><div class="tab-content" id="tab-analytics"><div style="position: relative; height:200px; width:100%;"><canvas id="analyticsChart"></canvas></div><ul id="analyticsList"></ul></div><div class="modal-footer"><button class="btn cancel-btn">Close</button></div></div></div>
<div class="modal" id="fileRequestModal"><div class="modal-box"><h3>Create File Request</h3><input type="text" id="fileRequestLabel" placeholder="Label (e.g., 'Project Submissions')" class="full-input"><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="createFileRequestBtn">Create</button></div></div></div>
<div class="modal" id="fileRequestResultModal"><div class="modal-box"><h3>File Request Created</h3><input type="text" id="fileRequestResultInput" class="full-input" readonly><div class="modal-footer"><button class="btn cancel-btn">Close</button><button class="btn confirm-btn" id="copyFileRequestBtn">Copy Link</button></div></div></div>
<div class="modal" id="folderModal"><div class="modal-box"><h3>New Folder</h3><input type="text" id="folderNameInput" class="full-input"><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="createFolderBtn">Create</button></div></div></div>
<div class="modal" id="remoteModal"><div class="modal-box"><h3>Remote Upload</h3><input type="url" id="remoteUrlInput" class="full-input"><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="startRemoteBtn">Fetch</button></div></div></div>
<div class="modal" id="renameModal"><div class="modal-box"><h3>Rename</h3><input type="text" id="renameInput" class="full-input"><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="confirmRenameBtn">Save</button></div></div></div>
<div class="modal" id="metaModal"><div class="modal-box"><h3>Details</h3><textarea id="descInput" placeholder="Description" class="full-input"></textarea><input type="text" id="tagsInput" placeholder="Tags (comma, separated)" class="full-input"><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="saveMetaBtn">Save</button></div></div></div>
<div class="modal" id="moveModal"><div class="modal-box"><h3>Move Items</h3><input type="text" id="moveFolderInput" class="full-input" placeholder="Destination folder ID, leave empty for root"><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="confirmMoveBtn">Move</button></div></div></div>
<div class="modal" id="transferOwnershipModal"><div class="modal-box"><h3>Transfer Ownership</h3><input type="text" id="transferOwnerInput" class="full-input" placeholder="Username of the new owner"><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="confirmTransferOwnershipBtn">Transfer</button></div></div></div>
<div class="modal" id="convertModal"><div class="modal-box"><h3>Convert Image</h3><select id="convertFormatInput" class="full-input"><option value="jpg">JPG</option><option value="png">PNG</option><option value="webp">WEBP</option></select><div class="modal-footer"><button class="btn cancel-btn">Cancel</button><button class="btn confirm-btn" id="confirmConvertBtn">Convert</button></div></div></div>
<div class="modal" id="uploadProgressModal">
    <div class="modal-box upload-progress-box">
        <div class="upload-progress-head">
            <div>
                <span class="upload-progress-badge">Live Upload Queue</span>
                <h3>Upload sedang berjalan</h3>
                <p id="uploadModalSummary">Menyiapkan file untuk dikirim ke server.</p>
            </div>
            <button class="icon-btn" type="button" id="closeUploadProgressBtn" aria-label="Close upload progress">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
        <div class="upload-progress-overall">
            <div class="upload-progress-rail">
                <div class="upload-progress-fill" id="uploadOverallFill"></div>
            </div>
            <div class="upload-progress-meta">
                <strong id="uploadOverallLabel">0%</strong>
                <span id="uploadOverallCount">0 / 0 selesai</span>
            </div>
        </div>
        <div class="upload-progress-list" id="uploadProgressList"></div>
    </div>
</div>
<input type="file" id="fileInput" multiple hidden>

<style>
    .dashboard-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.9fr);
        gap: 1.4rem;
        margin-bottom: 1rem;
        padding: 1.55rem;
        border-radius: 26px;
        background:
            radial-gradient(circle at top right, rgba(249,115,22,0.14), transparent 24%),
            linear-gradient(135deg, rgba(15,23,42,0.96), rgba(37,99,235,0.9));
        color: #fff;
        border: 1px solid rgba(255,255,255,0.14);
    }
    .dashboard-hero-badge {
        display: inline-flex;
        padding: 0.35rem 0.72rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .dashboard-hero h2 { margin: 0.8rem 0 0.7rem; font-size: clamp(1.7rem, 2.8vw, 2.35rem); line-height: 1.15; }
    .dashboard-hero p { margin: 0; color: rgba(255,255,255,0.76); line-height: 1.72; max-width: 740px; }
    .hero-storage-strip {
        display: grid;
        gap: 0.7rem;
        margin-top: 1rem;
        padding: 0.95rem 1rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.14);
        max-width: 560px;
    }
    .hero-storage-strip small {
        display: block;
        color: rgba(255,255,255,0.68);
        margin-bottom: 0.2rem;
    }
    .hero-storage-strip strong { font-size: 1rem; }
    .hero-storage-rail,
    .upload-progress-rail {
        width: 100%;
        height: 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.12);
        overflow: hidden;
    }
    .hero-storage-fill,
    .upload-progress-fill {
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: linear-gradient(90deg, #38bdf8, #f97316);
        transition: width 0.25s ease;
    }
    .dashboard-hero-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.9rem;
    }
    .hero-stat-card {
        padding: 1rem;
        border-radius: 20px;
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.16);
    }
    .hero-stat-card small {
        display: block;
        color: rgba(255,255,255,0.7);
        margin-bottom: 0.25rem;
    }
    .hero-stat-card strong { font-size: 1.25rem; }
    .hero-stat-card span {
        display: block;
        margin-top: 0.3rem;
        color: rgba(255,255,255,0.68);
        font-size: 0.82rem;
        line-height: 1.55;
    }
    .dashboard-quick-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }
    .quick-card {
        display: flex;
        gap: 1rem;
        align-items: center;
        padding: 1rem 1.05rem;
        border-radius: 22px;
        background: var(--card);
        border: 1px solid var(--border);
        cursor: pointer;
        text-align: left;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .quick-card:hover {
        transform: translateY(-3px);
        border-color: rgba(37,99,235,0.35);
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.08);
    }
    .quick-card i {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(37,99,235,0.10);
        color: #2563eb;
        font-size: 1.2rem;
    }
    .quick-card strong { display: block; color: var(--text); }
    .quick-card small { color: var(--muted-text); }
    .file-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 14px;
    }
    .file-visibility-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: 0.4rem;
        padding: 0.14rem 0.5rem;
        border-radius: 999px;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        vertical-align: middle;
    }
    .file-visibility-badge.public {
        background: rgba(22, 163, 74, 0.12);
        color: #15803d;
    }
    .file-visibility-badge.private {
        background: rgba(239, 68, 68, 0.12);
        color: #b91c1c;
    }
    .share-link-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    .share-custom-row {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }
    .context-menu {
        max-height: min(72vh, 420px);
        overflow-y: auto;
        overscroll-behavior: contain;
    }
    .main-content {
        -webkit-overflow-scrolling: touch;
    }
    .upload-progress-box {
        width: min(760px, calc(100vw - 2rem));
        max-width: 760px;
        padding: 1.25rem;
        border-radius: 28px;
    }
    .upload-progress-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
        margin-bottom: 1rem;
    }
    .upload-progress-head h3 {
        margin: 0.45rem 0 0.25rem;
        font-size: 1.45rem;
    }
    .upload-progress-head p {
        margin: 0;
        color: var(--muted-text);
        line-height: 1.6;
    }
    .upload-progress-badge {
        display: inline-flex;
        padding: 0.35rem 0.72rem;
        border-radius: 999px;
        background: rgba(37,99,235,0.1);
        color: #2563eb;
        font-size: 0.76rem;
        font-weight: 800;
