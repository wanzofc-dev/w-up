    }
    .upload-row {
        padding: 1rem;
        border-radius: 20px;
        background: var(--bg-secondary);
        border: 1px solid var(--border);
    }
    .upload-row-top {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        margin-bottom: 0.7rem;
    }
    .upload-row-name {
        font-weight: 700;
        color: var(--text);
        word-break: break-word;
    }
    .upload-row-size,
    .upload-row-note {
        color: var(--muted-text);
        font-size: 0.84rem;
        line-height: 1.55;
    }
    .upload-row-note { margin-top: 0.55rem; }
    .upload-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }
    .upload-status.uploading { background: rgba(37,99,235,0.1); color: #2563eb; }
    .upload-status.success { background: rgba(22,163,74,0.12); color: #15803d; }
    .upload-status.error { background: rgba(239,68,68,0.12); color: #b91c1c; }
    .upload-status.info { background: rgba(148,163,184,0.12); color: #475569; }
    @media (hover: none), (pointer: coarse) {
        .context-trigger {
            opacity: 1 !important;
            background: rgba(15, 23, 42, 0.08);
            border-radius: 999px;
        }
    }
    .tabs { display: flex; border-bottom: 1px solid var(--border); margin-bottom: 1.5rem; }
    .tab-btn { background: none; border: none; padding: 0.75rem 1rem; cursor: pointer; color: var(--muted-text); border-bottom: 2px solid transparent; font-weight: 600; font-size: 0.9rem; }
    .tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }
    .tab-content { display: none; }
    .tab-content.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    #analyticsList { list-style-type: none; padding: 0; font-size: 0.9rem; color: var(--muted-text); margin-top: 1.5rem; }
    #analyticsList li { margin-bottom: 0.5rem; }
    @media (max-width: 980px) {
        .dashboard-hero, .dashboard-quick-grid { grid-template-columns: 1fr; }
        .dashboard-hero-stats { grid-template-columns: 1fr; }
        .share-link-toolbar, .share-custom-row { flex-direction: column; align-items: stretch; }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    const currentFolderId = new URLSearchParams(window.location.search).get('folderId');
    const currentFilter = new URLSearchParams(window.location.search).get('filter');
    const currentType = new URLSearchParams(window.location.search).get('type');
    const fileInput = document.getElementById('fileInput');
    const dropZone = document.getElementById('dropZone');
    const sidebar = document.getElementById('mainSidebar');
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebarOverlay = document.getElementById('sidebarOverlay');
    const closeSidebarBtn = document.getElementById('closeSidebarBtn');
    const fileGrid = document.getElementById('fileGrid');
    const uploadProgressModal = document.getElementById('uploadProgressModal');
    const uploadProgressList = document.getElementById('uploadProgressList');
    const uploadOverallFill = document.getElementById('uploadOverallFill');
    const uploadOverallLabel = document.getElementById('uploadOverallLabel');
    const uploadOverallCount = document.getElementById('uploadOverallCount');
    const uploadModalSummary = document.getElementById('uploadModalSummary');
    const closeUploadProgressBtn = document.getElementById('closeUploadProgressBtn');
    const dashboardState = {
        stats: {
            ownedFiles: <%- JSON.stringify(dashboardStats ? dashboardStats.ownedFiles : files.filter(file => !file.isFolder).length) %>,
            ownedFolders: <%- JSON.stringify(dashboardStats ? dashboardStats.ownedFolders : files.filter(file => file.isFolder).length) %>,
            sharedItems: <%- JSON.stringify(dashboardStats ? dashboardStats.sharedItems : 0) %>,
            currentUsage: <%- JSON.stringify(dashboardStats ? dashboardStats.currentUsage : 0) %>,
            totalDownloads: <%- JSON.stringify(dashboardStats ? dashboardStats.totalDownloads : 0) %>
        },
        storage: {
            total: <%- JSON.stringify(totalLimit || 0) %>
        },
        uploading: false,
        uploadItems: []
    };
    const STANDARD_UPLOAD_LIMIT_BYTES = 20 * 1024 * 1024;
    const DEFAULT_CHUNK_UPLOAD_BYTES = 5 * 1024 * 1024;
    let pendingMoveIds = [];

    function escapeHtml(value = '') {
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatBytes(bytes = 0) {
        const value = Number(bytes || 0);
        if (value >= 1024 * 1024 * 1024) return `${(value / 1024 / 1024 / 1024).toFixed(2)} GB`;
        if (value >= 1024 * 1024) return `${(value / 1024 / 1024).toFixed(2)} MB`;
        if (value >= 1024) return `${(value / 1024).toFixed(2)} KB`;
        return `${value} B`;
    }

    function readBlobAsDataUrl(blob) {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(reader.result);
            reader.onerror = () => reject(new Error('Failed to read blob chunk.'));
            reader.readAsDataURL(blob);
        });
    }

    function getFileExtension(name = '') {
        const parts = String(name).split('.');
        return parts.length > 1 ? parts.pop().toLowerCase() : '';
    }

    function getFilePreviewMarkup(file) {
        if (file.isFolder) return '<i class="fa-solid fa-folder folder-icon"></i>';
        if ((file.contentType || '').startsWith('image/')) {
            return `<img src="/w-upload/raw/${encodeURIComponent(file.customAlias)}" alt="${escapeHtml(file.originalName)}" loading="lazy" class="file-thumb">`;
        }
        if ((file.contentType || '').startsWith('video/')) return '<i class="fa-solid fa-video video-icon"></i>';
        const ext = getFileExtension(file.originalName);
        if (ext === 'pdf') return '<i class="fa-solid fa-file-pdf file-icon"></i>';
        if (ext === 'zip' || ext === 'rar') return '<i class="fa-solid fa-file-zipper file-icon"></i>';
        if (ext === 'md') return '<i class="fa-brands fa-markdown file-icon"></i>';
        if (['js', 'html', 'css', 'py', 'java', 'json', 'xml', 'sql'].includes(ext)) return '<i class="fa-solid fa-file-code file-icon"></i>';
        return '<i class="fa-solid fa-file file-icon"></i>';
    }

    function buildFileCardMarkup(file) {
        const ext = getFileExtension(file.originalName);
        const safeName = escapeHtml(file.originalName);
        const href = file.isFolder
            ? `/dashboard?folderId=${encodeURIComponent(file.id)}`
            : `/w-upload/file/${encodeURIComponent(file.customAlias)}`;
        const meta = file.isFolder
            ? 'Folder'
            : `${formatBytes(file.size)} <span class="file-visibility-badge ${file.isHidden ? 'private' : 'public'}">${file.isHidden ? 'Private' : 'Public'}</span>`;

        return `
            <div class="file-card ${file.isFolder ? 'folder' : ''}"
                 data-id="${escapeHtml(file.id)}"
                 data-name="${safeName}"
                 data-alias="${escapeHtml(file.customAlias)}"
                 data-type="${file.isFolder ? 'folder' : 'file'}"
                 data-content-type="${escapeHtml(file.contentType || 'application/octet-stream')}"
                 data-is-hidden="${file.isHidden ? 'true' : 'false'}"
                 data-size="${Number(file.size || 0)}"
                 data-created-at="${escapeHtml(file.createdAt || '')}"
                 data-ext="${escapeHtml(ext)}"
                 draggable="true">
                <div class="selection-check">
                    <input type="checkbox" class="file-check" value="${escapeHtml(file.id)}">
                </div>
                <div class="file-preview">
                    ${getFilePreviewMarkup(file)}
                </div>
                <div class="file-details">
                    <a href="${href}" class="filename">${safeName}</a>
                    <div class="meta">${meta}</div>
                </div>
                <div class="context-trigger"><i class="fa-solid fa-ellipsis-vertical"></i></div>
            </div>
        `;
    }

    function matchesCurrentView(file) {
        if (currentFilter === 'trash' || currentFilter === 'shared' || currentFilter === 'starred') return false;
        if (currentFolderId && String(file.parentId || '') !== String(currentFolderId)) return false;
        if (!currentFolderId && file.parentId) return false;
        if (currentType === 'image' && !(file.contentType || '').startsWith('image/')) return false;
        if (currentType === 'video' && !(file.contentType || '').startsWith('video/')) return false;
        if (currentType === 'doc' && !/pdf|document|text/i.test(file.contentType || '')) return false;
        return true;
    }

    function updateDashboardStatsUi() {
        const used = Number(dashboardState.stats.currentUsage || 0);
        const total = Number(dashboardState.storage.total || 0);
        const percentage = total > 0 ? Math.min(100, (used / total) * 100) : 0;
        document.getElementById('statOwnedFiles').textContent = dashboardState.stats.ownedFiles;
        document.getElementById('statOwnedFolders').textContent = dashboardState.stats.ownedFolders;
        document.getElementById('statSharedItems').textContent = dashboardState.stats.sharedItems;
        document.getElementById('statDownloads').textContent = dashboardState.stats.totalDownloads;
        document.getElementById('statStorageUsed').textContent = `${(used / 1024 / 1024 / 1024).toFixed(2)} GB`;
        document.getElementById('statStorageDetail').textContent = `${(used / 1024 / 1024 / 1024).toFixed(2)} / ${(total / 1024 / 1024 / 1024).toFixed(2)} GB tersinkron.`;
        document.getElementById('heroStorageUsage').textContent = `${(used / 1024 / 1024 / 1024).toFixed(2)} GB / ${(total / 1024 / 1024 / 1024).toFixed(2)} GB`;
        document.getElementById('heroStorageFill').style.width = `${percentage}%`;

        const storageFill = document.getElementById('storageFill');
        const storagePercent = document.getElementById('storagePercent');
        const storageMeta = document.getElementById('storageMeta');
        if (storageFill && storagePercent && storageMeta) {
            storageFill.style.width = `${percentage}%`;
            storagePercent.textContent = `${percentage.toFixed(1)}%`;
            storageMeta.textContent = `${(used / 1024 / 1024 / 1024).toFixed(2)} GB / ${(total / 1024 / 1024 / 1024).toFixed(2)} GB`;
            storageMeta.dataset.storageUsed = String(used);
            storageMeta.dataset.storageTotal = String(total);
        }
    }

    function openUploadProgressModal(totalFiles) {
        uploadProgressModal.classList.add('active');
        closeUploadProgressBtn.disabled = true;
        dashboardState.uploadItems = [];
        uploadProgressList.innerHTML = '';
        uploadOverallFill.style.width = '0%';
        uploadOverallLabel.textContent = '0%';
        uploadOverallCount.textContent = `0 / ${totalFiles} selesai`;
        uploadModalSummary.textContent = totalFiles > 1
            ? `${totalFiles} file sedang diproses dan dikirim ke server tanpa refresh halaman.`
            : '1 file sedang diproses dan dikirim ke server tanpa refresh halaman.';
    }

    function closeUploadProgressModal(force = false) {
        if (dashboardState.uploading && !force) return;
        uploadProgressModal.classList.remove('active');
    }

    function createUploadRow(file, index) {
        const row = document.createElement('div');
        row.className = 'upload-row';
        row.dataset.uploadId = String(index);
        row.innerHTML = `
            <div class="upload-row-top">
                <div>
                    <div class="upload-row-name">${escapeHtml(file.name)}</div>
                    <div class="upload-row-size">${formatBytes(file.size)}</div>
                </div>
                <span class="upload-status info">queued</span>
            </div>
            <div class="upload-progress-rail">
                <div class="upload-progress-fill" style="width: 0%;"></div>
            </div>
            <div class="upload-row-note">Menunggu giliran upload.</div>
        `;
        uploadProgressList.appendChild(row);
        return row;
    }

    function updateUploadRow(row, { percent, status, note }) {
        const clampedPercent = Math.max(0, Math.min(100, Number(percent || 0)));
        row.querySelector('.upload-progress-fill').style.width = `${clampedPercent}%`;
        row.querySelector('.upload-status').className = `upload-status ${status}`;
        row.querySelector('.upload-status').textContent = status;
        row.querySelector('.upload-row-note').textContent = note;
    }

    function updateUploadOverall(totalFiles) {
        const completed = dashboardState.uploadItems.filter(item => item.done).length;
        const aggregate = dashboardState.uploadItems.reduce((sum, item) => sum + Number(item.progress || 0), 0);
        const percent = totalFiles > 0 ? aggregate / totalFiles : 0;
        uploadOverallFill.style.width = `${percent}%`;
        uploadOverallLabel.textContent = `${Math.round(percent)}%`;
        uploadOverallCount.textContent = `${completed} / ${totalFiles} selesai`;
    }

    function appendUploadedFile(file) {
        if (!matchesCurrentView(file)) return;
        const emptyState = fileGrid.querySelector('.empty-state');
        if (emptyState) emptyState.remove();
        const wrapper = document.createElement('div');
        wrapper.innerHTML = buildFileCardMarkup(file).trim();
        const card = wrapper.firstElementChild;
        const existingFolders = Array.from(fileGrid.querySelectorAll('.file-card.folder'));
        const insertAfter = existingFolders[existingFolders.length - 1] || null;
        if (insertAfter && insertAfter.nextSibling) {
            fileGrid.insertBefore(card, insertAfter.nextSibling);
        } else if (insertAfter) {
            fileGrid.appendChild(card);
        } else {
            fileGrid.prepend(card);
        }
        attachFileCardEvents(card);
        attachSelectionHandler(card.querySelector('.file-check'));
    }

    function toggleSidebar() { sidebar.classList.toggle('active'); sidebarOverlay.classList.toggle('active'); }
    if(sidebarToggle) sidebarToggle.addEventListener('click', toggleSidebar);
    if(closeSidebarBtn) closeSidebarBtn.addEventListener('click', toggleSidebar);
    if(sidebarOverlay) sidebarOverlay.addEventListener('click', toggleSidebar);
    closeUploadProgressBtn?.addEventListener('click', () => closeUploadProgressModal());
    updateDashboardStatsUi();

    document.getElementById('quickUploadBtn')?.addEventListener('click', () => document.getElementById('uploadBtn').click());
    document.getElementById('quickFolderBtn')?.addEventListener('click', () => document.getElementById('newFolderBtn').click());
    document.getElementById('quickRequestBtn')?.addEventListener('click', () => document.getElementById('fileRequestBtn').click());

    document.getElementById('uploadBtn').addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => handleUpload(e.target.files));
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
    dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('drag-over'); handleUpload(e.dataTransfer.files); });
    document.addEventListener('paste', (e) => {
        const files = Array.from(e.clipboardData.items).filter(i => i.kind === 'file').map(i => i.getAsFile());
        if (files.length > 0) handleUpload(files);
    });

    async function handleUpload(files) {
        const queue = Array.from(files || []).filter(Boolean);
        if (!queue.length) return;
        dashboardState.uploading = true;
        openUploadProgressModal(queue.length);
        dashboardState.uploadItems = queue.map((file, index) => ({
            id: index,
            file,
            row: createUploadRow(file, index),
            progress: 0,
            done: false
        }));

        let successCount = 0;
        for (const item of dashboardState.uploadItems) {
            const result = item.file.size > STANDARD_UPLOAD_LIMIT_BYTES
                ? await uploadChunked(item)
                : await uploadStandard(item);
            if (result?.success) successCount += 1;
            updateUploadOverall(queue.length);
        }

        dashboardState.uploading = false;
        closeUploadProgressBtn.disabled = false;
        uploadModalSummary.textContent = successCount === queue.length
            ? `Semua ${queue.length} file selesai diupload tanpa refresh halaman.`
            : `${successCount} dari ${queue.length} file berhasil diupload. Sisanya perlu dicek ulang.`;
        fileInput.value = '';
        window.dispatchEvent(new Event('storage:refresh'));
    }
    
    async function uploadChunked(item) {
        const { file, row } = item;
        try {
            item.progress = 5;
            updateUploadRow(row, {
                percent: item.progress,
                status: 'uploading',
                note: 'Memulai sesi multipart upload ke server.'
            });
            updateUploadOverall(dashboardState.uploadItems.length);

            const initResponse = await fetch('/api/upload/chunk/init', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    filename: file.name,
                    totalSize: file.size,
                    contentType: file.type || 'application/octet-stream'
                })
            });
            const initData = await initResponse.json();
            if (!initResponse.ok) {
                throw new Error(initData.message || 'Chunk upload init failed.');
            }

            const chunkSize = Number(initData.chunkSize || DEFAULT_CHUNK_UPLOAD_BYTES);
            const totalChunks = Math.ceil(file.size / chunkSize);

            for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex += 1) {
                const start = chunkIndex * chunkSize;
                const end = Math.min(start + chunkSize, file.size);
                const blobChunk = file.slice(start, end);
                const base64Chunk = await readBlobAsDataUrl(blobChunk);

                const chunkResponse = await fetch('/api/upload/chunk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        sessionId: initData.sessionId,
                        chunkIndex,
                        base64Chunk
                    })
                });
                const chunkData = await chunkResponse.json();
                if (!chunkResponse.ok) {
                    throw new Error(chunkData.message || `Chunk ${chunkIndex + 1} failed.`);
                }

                item.progress = 10 + (((chunkIndex + 1) / totalChunks) * 80);
                updateUploadRow(row, {
                    percent: item.progress,
                    status: 'uploading',
                    note: `Chunk ${chunkIndex + 1}/${totalChunks} selesai dikirim.`
                });
                updateUploadOverall(dashboardState.uploadItems.length);
            }

            const finalizeResponse = await fetch('/api/upload/chunk/finalize', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId: initData.sessionId,
                    parentId: currentFolderId
                })
            });
            const finalizeData = await finalizeResponse.json();
            if (!finalizeResponse.ok) {
                throw new Error(finalizeData.message || 'Chunk upload finalize failed.');
            }

            item.progress = 100;
            item.done = true;
            if (finalizeData.file) {
                dashboardState.stats.ownedFiles += 1;
                dashboardState.stats.currentUsage += Number(finalizeData.file.size || 0);
                appendUploadedFile(finalizeData.file);
                updateDashboardStatsUi();
            }
            updateUploadRow(row, {
                percent: 100,
                status: 'success',
                note: 'File besar berhasil disimpan lewat multipart upload.'
            });
            showToast(finalizeData.message || `${file.name} uploaded`, 'success');
            return { success: true, data: finalizeData };
        } catch (error) {
            item.progress = 100;
            item.done = true;
            updateUploadRow(row, {
                percent: 100,
                status: 'error',
                note: error.message || 'Chunk upload gagal.'
            });
            showToast(error.message || `Upload gagal untuk ${file.name}`, 'error');
            return { success: false };
        }
    }

    function uploadStandard(item) {
        return new Promise((resolve) => {
            const { file, row } = item;
            const reader = new FileReader();
            reader.onprogress = (event) => {
                if (!event.lengthComputable) return;
                item.progress = Math.max(item.progress, (event.loaded / event.total) * 25);
                updateUploadRow(row, {
                    percent: item.progress,
                    status: 'uploading',
                    note: `Menyiapkan file: ${Math.round((event.loaded / event.total) * 100)}%`
                });
                updateUploadOverall(dashboardState.uploadItems.length);
            };
            reader.readAsDataURL(file);
            reader.onerror = () => {
                item.progress = 100;
                item.done = true;
                updateUploadRow(row, {
                    percent: 100,
                    status: 'error',
                    note: 'File tidak bisa dibaca dari perangkat.'
                });
                showToast(`Gagal membaca ${file.name}`, 'error');
                resolve({ success: false });
            };
            reader.onload = () => {
                const xhr = new XMLHttpRequest();
                const payload = JSON.stringify({
                    filename: file.name,
                    contentType: file.type || 'application/octet-stream',
                    base64: reader.result,
                    parentId: currentFolderId
                });
                xhr.open('POST', '/api/upload');
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.upload.onprogress = (event) => {
                    if (!event.lengthComputable) return;
                    item.progress = 25 + ((event.loaded / event.total) * 70);
                    updateUploadRow(row, {
                        percent: item.progress,
                        status: 'uploading',
                        note: `Mengirim ke server: ${Math.round((event.loaded / event.total) * 100)}%`
                    });
                    updateUploadOverall(dashboardState.uploadItems.length);
                };
                xhr.onload = () => {
                    let data = {};
                    try {
                        data = JSON.parse(xhr.responseText || '{}');
                    } catch (error) {}

                    item.progress = 100;
                    item.done = true;

                    if (xhr.status >= 200 && xhr.status < 300) {
                        if (data.file && !data.duplicate) {
                            dashboardState.stats.ownedFiles += 1;
                            dashboardState.stats.currentUsage += Number(data.file.size || 0);
                            appendUploadedFile(data.file);
                            updateDashboardStatsUi();
                        }
                        updateUploadRow(row, {
                            percent: 100,
                            status: data.duplicate ? 'info' : 'success',
                            note: data.duplicate
                                ? 'File duplikat terdeteksi. Server mengarahkan ke file yang sudah ada.'
                                : 'File berhasil disimpan dan kartu baru sudah masuk ke dashboard.'
                        });
                        showToast(data.message || `${file.name} uploaded`, data.duplicate ? 'warning' : 'success');
                        resolve({ success: true, data });
                        return;
                    }

                    updateUploadRow(row, {
                        percent: 100,
                        status: 'error',
                        note: data.message || 'Upload gagal di server.'
                    });
                    showToast(data.message || `Upload gagal untuk ${file.name}`, 'error');
                    resolve({ success: false, data });
                };
                xhr.onerror = () => {
                    item.progress = 100;
                    item.done = true;
                    updateUploadRow(row, {
                        percent: 100,
                        status: 'error',
                        note: 'Koneksi ke server terputus saat upload.'
                    });
                    showToast(`Upload gagal untuk ${file.name}`, 'error');
                    resolve({ success: false });
                };
                xhr.send(payload);
            };
        });
    }

    const contextMenu = document.getElementById('contextMenu');
    const visibilityStatusChip = document.getElementById('visibilityStatusChip');
    const toggleVisibilityBtn = document.getElementById('toggleVisibilityBtn');
    const customPrivateSlug = document.getElementById('customPrivateSlug');
    let contextTarget = null;
    window.contextTarget = null;

    function updateVisibilityUi() {
        if (!contextTarget || !visibilityStatusChip || !toggleVisibilityBtn) return;
        const isPrivate = contextTarget.dataset.isHidden === 'true';
        visibilityStatusChip.textContent = isPrivate ? 'Private' : 'Public';
        visibilityStatusChip.className = `file-visibility-badge ${isPrivate ? 'private' : 'public'}`;
        toggleVisibilityBtn.innerHTML = isPrivate
            ? '<i class="fa-solid fa-eye"></i> Set Public'
            : '<i class="fa-solid fa-eye-slash"></i> Set Private';
        document.getElementById('cmVisibility').innerHTML = isPrivate
            ? '<i class="fa-solid fa-eye"></i> Set Public'
            : '<i class="fa-solid fa-eye-slash"></i> Set Private';
    }

    function openContextMenu(card, x, y) {
        contextTarget = card;
        window.contextTarget = card;
        updateVisibilityUi();
        document.querySelectorAll('#contextMenu li[id]').forEach(item => item.style.display = 'flex');
        const isFile = card.dataset.type === 'file';
        let toolsVisible = false;
        if (isFile) {
            if (card.dataset.contentType.startsWith('image/')) toolsVisible = true;
            if (card.dataset.ext === 'zip') toolsVisible = true;
        }
        document.getElementById('cmOCR').style.display = (isFile && card.dataset.contentType.startsWith('image/')) ? 'flex' : 'none';
        document.getElementById('cmConvert').style.display = (isFile && card.dataset.contentType.startsWith('image/')) ? 'flex' : 'none';
        document.getElementById('cmExtract').style.display = (isFile && card.dataset.ext === 'zip') ? 'flex' : 'none';
        document.getElementById('cmToolsSeparator').style.display = toolsVisible ? 'block' : 'none';
        document.getElementById('renameInput').value = card.dataset.name;

        contextMenu.style.display = 'block';
        contextMenu.style.top = '0px';
        contextMenu.style.left = '0px';
        const menuRect = contextMenu.getBoundingClientRect();
        const clampedLeft = Math.max(12, Math.min(x, window.innerWidth - menuRect.width - 12));
        const clampedTop = Math.max(12, Math.min(y, window.innerHeight - menuRect.height - 12));
        contextMenu.style.left = `${clampedLeft}px`;
        contextMenu.style.top = `${clampedTop}px`;
    }

    function getPrivateShareLink(linkId) {
        return `${window.location.origin}/private/${linkId}`;
    }

    function attachFileCardEvents(card) {
        const trigger = card.querySelector('.context-trigger');
        card.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            openContextMenu(card, e.clientX, e.clientY);
        });

        trigger?.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const rect = trigger.getBoundingClientRect();
            openContextMenu(card, rect.right - 8, rect.bottom + 8);
        });
    }

    document.querySelectorAll('.file-card').forEach(attachFileCardEvents);

    document.addEventListener('click', (e) => {
        if(!e.target.closest('.context-menu')) contextMenu.style.display = 'none';
    });
    
    const allModals = document.querySelectorAll('.modal');
    function closeModal() {
        allModals.forEach(modal => {
            if (modal.id === 'uploadProgressModal') {
                closeUploadProgressModal();
                return;
            }
            modal.classList.remove('active');
        });
    }
    allModals.forEach(modal => {
        modal.addEventListener('click', (e) => {
            if (e.target !== modal) return;
            if (modal.id === 'uploadProgressModal') {
                closeUploadProgressModal();
                return;
            }
            modal.classList.remove('active');
        });
        modal.querySelector('.cancel-btn')?.addEventListener('click', closeModal);
    });

    const modalTriggers = { 'newFolderBtn': 'folderModal', 'remoteUploadBtn': 'remoteModal', 'fileRequestBtn': 'fileRequestModal', 'cmRename': 'renameModal', 'cmInfo': 'metaModal' };
    Object.entries(modalTriggers).forEach(([btnId, modalId]) => {
        const btn = document.getElementById(btnId);
        if(btn) btn.addEventListener('click', (e) => {
            e.preventDefault();
            contextMenu.style.display = 'none';
            document.getElementById(modalId).classList.add('active');
        });
    });

    async function performAction(url, method, body) {
        try {
            const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
            const data = await res.json();
            if (res.ok) {
                showToast(data.message || 'Action completed!', 'success');
                return true;
            } else {
                showToast(data.message || 'An error occurred.', 'error');
                return false;
            }
        } catch (error) {
            showToast('Network error.', 'error');
            return false;
        }
    }

    document.getElementById('cmOpen').addEventListener('click', () => {
        if (!contextTarget) return;
        const url = contextTarget.dataset.type === 'folder' ? `/dashboard?folderId=${contextTarget.dataset.id}` : `/w-upload/file/${contextTarget.dataset.alias}`;
        window.open(url, '_blank');
    });

    document.getElementById('cmCopyLink').addEventListener('click', () => {
        if (!contextTarget) return;
        const isPrivate = contextTarget.dataset.isHidden === 'true';
        const firstPrivateLink = contextTarget.dataset.primaryShareLink;
        const link = isPrivate && firstPrivateLink
            ? getPrivateShareLink(firstPrivateLink)
            : `${window.location.origin}/w-upload/file/${contextTarget.dataset.alias}`;

        if (isPrivate && !firstPrivateLink) {
            showToast('Create a private link first for this file.', 'warning');
            return;
        }

        navigator.clipboard.writeText(link);
        showToast('Link copied to clipboard!');
    });

    document.getElementById('cmVisibility').addEventListener('click', async () => {
        if (!contextTarget) return;
        const nextState = contextTarget.dataset.isHidden !== 'true';
        const success = await performAction(`/api/files/${contextTarget.dataset.id}/visibility`, 'PUT', { isHidden: nextState });
        if (success) {
            contextTarget.dataset.isHidden = nextState ? 'true' : 'false';
            const badge = contextTarget.querySelector('.file-visibility-badge');
            if (badge) {
                badge.textContent = nextState ? 'Private' : 'Public';
                badge.className = `file-visibility-badge ${nextState ? 'private' : 'public'}`;
            }
            updateVisibilityUi();
        }
    });

    document.getElementById('cmDelete').addEventListener('click', async () => {
        if (!contextTarget || !confirm('Move item to trash?')) return;
        if (await performAction(`/api/files/${contextTarget.dataset.id}`, 'DELETE')) location.reload();
    });

    document.getElementById('confirmRenameBtn').addEventListener('click', async () => {
        if (await performAction(`/api/files/${contextTarget.dataset.id}/rename`, 'PUT', { newName: document.getElementById('renameInput').value })) location.reload();
    });

    document.getElementById('createFolderBtn').addEventListener('click', async () => {
        if (await performAction('/api/folder', 'POST', { name: document.getElementById('folderNameInput').value, parentId: currentFolderId })) location.reload();
    });

    document.getElementById('startRemoteBtn').addEventListener('click', async () => {
        if (await performAction('/api/upload/remote', 'POST', { url: document.getElementById('remoteUrlInput').value, parentId: currentFolderId })) location.reload();
    });

    document.getElementById('saveMetaBtn').addEventListener('click', async () => {
        const body = { description: document.getElementById('descInput').value, tags: document.getElementById('tagsInput').value };
        if (await performAction(`/api/files/${contextTarget.dataset.id}/meta`, 'PUT', body)) location.reload();
    });

    document.getElementById('cmStar').addEventListener('click', async () => {
        if (!contextTarget) return;
        if (await performAction(`/api/files/bulk`, 'POST', { fileIds: [contextTarget.dataset.id], action: 'star' })) location.reload();
    });

    document.getElementById('cmMove').addEventListener('click', async () => {
        if (!contextTarget) return;
        pendingMoveIds = [contextTarget.dataset.id];
        document.getElementById('moveFolderInput').value = '';
        document.getElementById('moveModal').classList.add('active');
    });

    document.getElementById('createFileRequestBtn').addEventListener('click', async () => {
        const label = document.getElementById('fileRequestLabel').value;
        const res = await fetch('/api/file-requests', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ label, folderId: currentFolderId }) });
        const data = await res.json();
        if(res.ok) {
            document.getElementById('fileRequestResultInput').value = data.link;
            document.getElementById('fileRequestModal').classList.remove('active');
            document.getElementById('fileRequestResultModal').classList.add('active');
        }
    });

    document.getElementById('copyFileRequestBtn').addEventListener('click', async () => {
        const input = document.getElementById('fileRequestResultInput');
        if (!input.value) return;
        await navigator.clipboard.writeText(input.value);
        showToast('File request link copied!', 'success');
    });

    document.getElementById('cmTransferOwner').addEventListener('click', async () => {
        if (!contextTarget) return;
        document.getElementById('transferOwnerInput').value = '';
        document.getElementById('transferOwnershipModal').classList.add('active');
    });

    document.getElementById('cmShare').addEventListener('click', async () => {
        if (!contextTarget) return;
        document.getElementById('shareModal').classList.add('active');
        await loadShareData();
    });
    
    document.getElementById('addCollabBtn').addEventListener('click', async () => {
        const username = document.getElementById('shareCollabUser').value;
        const role = document.getElementById('collabRole').value;
        if(!username) return;
        if (await performAction(`/api/files/${contextTarget.dataset.id}/collaborator`, 'POST', { username, role })) {
            document.getElementById('shareCollabUser').value = '';
            loadShareData();
        }
    });

    document.getElementById('createShareLinkBtn').addEventListener('click', async () => {
        if (!contextTarget) return;
        const payload = { customSlug: customPrivateSlug?.value?.trim() || '' };
        if (await performAction(`/api/files/${contextTarget.dataset.id}/share-links`, 'POST', payload)) {
            if (customPrivateSlug) customPrivateSlug.value = '';
            loadShareData();
        }
    });

    toggleVisibilityBtn?.addEventListener('click', async () => {
        if (!contextTarget) return;
        const nextState = contextTarget.dataset.isHidden !== 'true';
        const success = await performAction(`/api/files/${contextTarget.dataset.id}/visibility`, 'PUT', { isHidden: nextState });
        if (success) {
            contextTarget.dataset.isHidden = nextState ? 'true' : 'false';
            const badge = contextTarget.querySelector('.file-visibility-badge');
            if (badge) {
                badge.textContent = nextState ? 'Private' : 'Public';
                badge.className = `file-visibility-badge ${nextState ? 'private' : 'public'}`;
            }
            updateVisibilityUi();
        }
    });
    
    window.revokeLink = async (linkId) => {
        if(!confirm('Revoke this link?')) return;
        if (await performAction(`/api/files/${contextTarget.dataset.id}/share-links/${linkId}`, 'DELETE')) loadShareData();
    };

    window.removeCollab = async (username) => {
        if(!confirm(`Remove ${username} from collaborators?`)) return;
        if (await performAction(`/api/files/${contextTarget.dataset.id}/collaborator/${encodeURIComponent(username)}`, 'DELETE')) {
            loadShareData();
        }
    };
    
    async function loadShareData() {
        if (!contextTarget) return;
        const res = await fetch(`/api/files/${contextTarget.dataset.id}/share-details`);
        if (!res.ok) { showToast('Failed to load share data', 'error'); return; }
        const data = await res.json();
        contextTarget.dataset.isHidden = data.isHidden ? 'true' : 'false';
        contextTarget.dataset.primaryShareLink = data.shareLinks[0]?.linkId || '';
        updateVisibilityUi();
        
        const collabList = document.getElementById('collaboratorsList');
        collabList.innerHTML = data.collaborators.map(c => `<div class="list-item"><span>${c.user.username} (${c.role})</span><button class="icon-btn danger" onclick="removeCollab('${c.user.username}')"><i class="fa-solid fa-trash"></i></button></div>`).join('');

        const linksList = document.getElementById('shareLinksList');
        linksList.innerHTML = data.shareLinks.map(l => {
            const fullLink = getPrivateShareLink(l.linkId);
            return `<div class="list-item"><code>${fullLink}</code><div><button class="icon-btn" onclick="navigator.clipboard.writeText('${fullLink}'); showToast('Copied!')"><i class="fa-solid fa-copy"></i></button><button class="icon-btn danger" onclick="revokeLink('${l.linkId}')"><i class="fa-solid fa-trash"></i></button></div></div>`;
        }).join('') || '<p class="text-muted">No private links created yet.</p>';
        
        await loadAnalytics();
    }
    
    let analyticsChartInstance;
    async function loadAnalytics() {
        if (!contextTarget) return;
        const res = await fetch(`/api/files/${contextTarget.dataset.id}/analytics`);
        const data = await res.json();
        const ctx = document.getElementById('analyticsChart').getContext('2d');
        const list = document.getElementById('analyticsList');
        list.innerHTML = '';
        
        const labels = data.map(d => d._id || 'Unknown');
        const downloads = data.map(d => d.downloads);
        
        data.forEach(d => { list.innerHTML += `<li>${d._id || 'Unknown'}: ${d.views} views, ${d.downloads} downloads</li>`; });

        if (analyticsChartInstance) analyticsChartInstance.destroy();
        analyticsChartInstance = new Chart(ctx, {
            type: 'bar',
            data: { labels, datasets: [{ label: '# of Downloads by Country', data: downloads, backgroundColor: 'rgba(79, 70, 229, 0.5)', borderColor: 'rgba(79, 70, 229, 1)', borderWidth: 1 }] },
            options: { scales: { y: { beginAtZero: true } } }
        });
    }

    document.querySelectorAll('.tabs .tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const tabContainer = e.target.closest('.tabs');
            const modalBox = e.target.closest('.modal-box');
            tabContainer.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
            modalBox.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            e.target.classList.add('active');
            modalBox.querySelector(`#${e.target.dataset.tab}`).classList.add('active');
        });
    });

    document.getElementById('cmOCR').addEventListener('click', async () => {
        if (!contextTarget) return;
        showToast('Starting OCR...', 'info');
        if(await performAction(`/api/files/${contextTarget.dataset.id}/ocr`, 'POST')) {
            // Further action could be to display result in a modal
        }
    });
    
    document.getElementById('cmExtract').addEventListener('click', async () => {
        if (!contextTarget) return;
        showToast('Extracting archive...', 'info');
        if (await performAction(`/api/files/${contextTarget.dataset.id}/extract`, 'POST')) setTimeout(() => location.reload(), 1000);
    });

    document.getElementById('cmConvert').addEventListener('click', async () => {
        if (!contextTarget) return;
        document.getElementById('convertFormatInput').value = 'jpg';
        document.getElementById('convertModal').classList.add('active');
    });

    const selectedIds = new Set();
    function attachSelectionHandler(chk) {
        if (!chk) return;
        chk.addEventListener('change', (e) => {
            const card = e.target.closest('.file-card');
            if (e.target.checked) { selectedIds.add(e.target.value); card.classList.add('selected'); }
            else { selectedIds.delete(e.target.value); card.classList.remove('selected'); }
            const bar = document.getElementById('bulkActions');
            document.getElementById('selectedCount').textContent = selectedIds.size;
            if(selectedIds.size > 0) bar.classList.add('active'); else bar.classList.remove('active');
        });
    }
    document.querySelectorAll('.file-check').forEach(attachSelectionHandler);

    document.getElementById('emptyTrashBtn')?.addEventListener('click', async () => {
        if(!confirm('Permanently delete all files in trash?')) return;
        if(await performAction('/api/trash/empty', 'DELETE')) location.reload();
    });

    async function handleBulkAction(action, extraParams = {}) {
        const ids = Array.from(selectedIds);
        if (ids.length === 0) return;
        if (await performAction('/api/files/bulk', 'POST', { fileIds: ids, action, ...extraParams })) location.reload();
    }

    document.getElementById('bulkDeleteBtn').addEventListener('click', () => handleBulkAction('delete'));
    document.getElementById('bulkStarBtn').addEventListener('click', () => handleBulkAction('star'));
    document.getElementById('bulkMoveBtn').addEventListener('click', () => {
        pendingMoveIds = Array.from(selectedIds);
        if (!pendingMoveIds.length) return;
        document.getElementById('moveFolderInput').value = '';
        document.getElementById('moveModal').classList.add('active');
    });

    document.getElementById('confirmMoveBtn').addEventListener('click', async () => {
        const folderId = document.getElementById('moveFolderInput').value.trim();
        if (!pendingMoveIds.length) return;
        if (await performAction('/api/files/bulk', 'POST', { fileIds: pendingMoveIds, action: 'move', targetFolderId: folderId || null })) location.reload();
    });

    document.getElementById('confirmTransferOwnershipBtn').addEventListener('click', async () => {
        const username = document.getElementById('transferOwnerInput').value.trim();
        if (!username || !contextTarget) return;
        if (!confirm(`Transfer ownership to ${username}? This cannot be undone.`)) return;
        if (await performAction(`/api/files/${contextTarget.dataset.id}/transfer-ownership`, 'POST', { username })) location.reload();
    });

    document.getElementById('confirmConvertBtn').addEventListener('click', async () => {
        const toFormat = document.getElementById('convertFormatInput').value;
        if (!contextTarget || !toFormat) return;
        showToast(`Converting to ${toFormat}...`, 'info');
        if (await performAction(`/api/files/${contextTarget.dataset.id}/convert`, 'POST', { toFormat })) setTimeout(() => location.reload(), 1000);
    });
});
</script>

<%- include('partials/footer') %>
