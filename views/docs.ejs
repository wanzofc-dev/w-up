            justify-content: center;
        }
    }
    [data-theme="dark"] .docs-sidebar {
        border-color: rgba(56, 189, 248, 0.18);
        background: linear-gradient(180deg, rgba(8,18,34,0.96), rgba(11,24,43,0.92));
        box-shadow: 0 24px 46px rgba(2, 8, 23, 0.42);
    }
    [data-theme="dark"] .docs-nav-eyebrow,
    [data-theme="dark"] .docs-eyebrow,
    [data-theme="dark"] .section-kicker {
        background: rgba(56, 189, 248, 0.12);
        color: #c8eeff;
    }
    [data-theme="dark"] .docs-nav a {
        color: #9db2d0;
    }
    [data-theme="dark"] .docs-nav a:hover,
    [data-theme="dark"] .docs-nav a.active {
        color: #f8fbff;
        background: linear-gradient(135deg, rgba(56,189,248,0.16), rgba(251,146,60,0.16));
    }
    [data-theme="dark"] .docs-toggle-btn {
        background: rgba(10,19,33,0.92);
        border-color: rgba(56, 189, 248, 0.18);
        box-shadow: 0 18px 30px rgba(2, 8, 23, 0.32);
    }
    [data-theme="dark"] .docs-section,
    [data-theme="dark"] .docs-card,
    [data-theme="dark"] .endpoint-card,
    [data-theme="dark"] .feature-card,
    [data-theme="dark"] .developer-center-item {
        background: linear-gradient(180deg, rgba(9,18,31,0.96), rgba(12,24,41,0.92));
        border-color: rgba(56, 189, 248, 0.14);
        box-shadow: 0 22px 44px rgba(2, 8, 23, 0.28);
    }
    [data-theme="dark"] .docs-card p,
    [data-theme="dark"] .endpoint-card p,
    [data-theme="dark"] .feature-card p,
    [data-theme="dark"] .section-heading p,
    [data-theme="dark"] .doc-list {
        color: #9db2d0;
    }
    [data-theme="dark"] .feature-icon,
    [data-theme="dark"] .developer-center-item i,
    [data-theme="dark"] .doc-pill {
        color: #d9f4ff;
        background: linear-gradient(135deg, rgba(56,189,248,0.18), rgba(251,146,60,0.16));
    }
    [data-theme="dark"] .url {
        color: #f2f7ff;
    }
    [data-theme="dark"] .branding-card.alt {
        background: linear-gradient(180deg, rgba(12,23,39,0.95), rgba(25,18,29,0.92));
    }
    [data-theme="dark"] .sidebar-overlay {
        background: rgba(2, 8, 23, 0.72);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('docsSidebar');
    const toggleBtn = document.getElementById('docsToggleBtn');
    const overlay = document.getElementById('docsOverlay');
    const links = document.querySelectorAll('.docs-nav a');
    const sections = document.querySelectorAll('.docs-section, .docs-hero');

    function toggleDocsSidebar(forceClose = false) {
        if (!sidebar || !overlay) return;
        if (forceClose) {
            sidebar.classList.remove('active');
            overlay.classList.remove('active');
            return;
        }
        sidebar.classList.toggle('active');
        overlay.classList.toggle('active');
    }

    toggleBtn?.addEventListener('click', () => toggleDocsSidebar());
    overlay?.addEventListener('click', () => toggleDocsSidebar(true));

    links.forEach((anchor) => {
        anchor.addEventListener('click', (event) => {
            event.preventDefault();
            const target = document.querySelector(anchor.getAttribute('href'));
            if (!target) return;
            links.forEach((item) => item.classList.remove('active'));
            anchor.classList.add('active');
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            toggleDocsSidebar(true);
        });
    });

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.getAttribute('id');
            const activeLink = document.querySelector(`.docs-nav a[href="#${id}"]`);
            if (!activeLink) return;
            links.forEach((item) => item.classList.remove('active'));
            activeLink.classList.add('active');
        });
    }, { rootMargin: '-25% 0px -55% 0px', threshold: 0.1 });

    sections.forEach((section) => observer.observe(section));
});
</script>

